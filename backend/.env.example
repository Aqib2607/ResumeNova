##################################################
# ResumeNova – Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
##################################################

# ─── Application ───────────────────────────────
APP_NAME=ResumeNova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─── Logging ───────────────────────────────────
LOG_CHANNEL=daily
LOG_STACK=daily,resumenova
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
# LOG_SLACK_WEBHOOK_URL=

# ─── Database (MySQL) ──────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resumenova
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ───────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Queue ─────────────────────────────────────
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ─── Cache ─────────────────────────────────────
CACHE_STORE=database
# CACHE_PREFIX=resumenova_

# ─── Redis (optional – use for production queue/cache) ─
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ──────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@resumenova.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── File Storage ──────────────────────────────
FILESYSTEM_DISK=local
# Switch to 's3' in production:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Google OAuth (Socialite) ──────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─── Memcached (optional) ──────────────────────
MEMCACHED_HOST=127.0.0.1

# ─── Vite ──────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
